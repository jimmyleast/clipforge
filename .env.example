# ============================================
# ClipForge — Environment Variables
# ============================================

# API Auth — generate with: openssl rand -hex 32
CLIPFORGE_API_KEY=your-secure-api-key-here

# Supabase — Create a NEW project for ClipForge
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2 — S3-compatible storage
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=cf-public-assets
R2_PUBLIC_URL=https://cdn.yourdomain.com

# Worker Configuration
WORKER_ID=worker-1
WORKER_POLL_INTERVAL_MS=2000
WORKER_CONCURRENCY=2
WORKER_JOB_TYPES=text_overlay,caption_burn,audio_dub,trim,concat,ad_creative

# App
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://clipforge-web.up.railway.app

# Dashboard — API key for client-side job submission (set same as CLIPFORGE_API_KEY)
NEXT_PUBLIC_CLIPFORGE_API_KEY=your-secure-api-key-here
